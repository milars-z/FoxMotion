# Copy to deploy/runpod/.env on the container disk. Trusted local Bash settings.
INFERENCE_BACKEND=mock
RUNPOD_VOLUME=/workspace
RUNTIME_DIR=/opt/video-runtime
COMFYUI_HOME=/opt/ComfyUI
# Python interpreter from the RunPod image that can import its original torch.
BASE_PYTHON=python3
MIN_FREE_GIB=8
# Overrides. Defaults follow the selected volume and runtime paths.
# COMFYUI_MODEL_DIR=/workspace/models
# RESULT_DIR=/workspace/outputs
# BACKUP_DIR=/workspace/backup
# WORKFLOW_DIR=/workspace/config/workflows
# DATA_DIR=/opt/video-runtime/data
# Existing audited ComfyUI checkout, or exact 40-character official commit to clone.
# Required for ComfyUI bootstrap/start. See README_RUNPOD.md.
# COMFYUI_REV=

# Node cache policy. Select classic to keep reusable loader outputs between jobs.
COMFY_NODE_CACHE=none
# Optional full synthetic FL2VA video, once per Comfy process.
COMFY_WARMUP=off
# Seconds of idle time before a native Comfy release; 0 keeps the cache.
GPU_IDLE_RELEASE_SECONDS=0
# Container-local private results expire after completion, in seconds (60 to 604800).
PRIVATE_RETENTION_SECONDS=3600
